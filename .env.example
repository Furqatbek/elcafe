# Environment variables for Qahvoon (branding + core config).
#
# For the CANONICAL, complete required-secrets list and the Docker launch flow, use
# `.env.docker.example` (see docs/LAUNCH.md). This file documents branding + a subset.
# Copy to .env and fill in real values:
#   cp .env.example .env && nano .env

# ===========================================
# BRANDING
# ===========================================
BRAND_NAME=Qahvoon
BRAND_SHORT_NAME=Qahvoon
BRAND_DOMAIN=qahvoon.uz
BRAND_API_URL=https://www.qahvoon.uz
BRAND_SUPPORT_EMAIL=support@qahvoon.uz
BRAND_TEAM_NAME=Qahvoon Team

VITE_BRAND_NAME=Qahvoon
VITE_BRAND_SHORT_NAME=Qahvoon
VITE_BRAND_DOMAIN=qahvoon.uz
VITE_BRAND_API_URL=https://www.qahvoon.uz
VITE_BRAND_SUPPORT_EMAIL=support@qahvoon.uz
# Demo login autofill for showcase builds ONLY — leave BLANK for real deployments.
# (These do NOT create an account; they only pre-fill the login form in demo builds.
# Never ship a real/weak password here.)
VITE_BRAND_DEMO_EMAIL=
VITE_BRAND_DEMO_PASSWORD=
VITE_BRAND_COLOR_PRIMARY=#2563eb
VITE_BRAND_COMPANY_NAME=Qahvoon

# ===========================================
# DATABASE
# ===========================================
DB_HOST=db
DB_PORT=5432
DB_NAME=elcafe
DB_USER=elcafe
DB_PASSWORD=CHANGE_ME_strong_password_here

# ===========================================
# JWT SECRET (REQUIRED for production — the app refuses to boot without it.
# Local dev uses a dev-only default from docker-compose.local.yml.)
# Generate: openssl rand -hex 32
# ===========================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ===========================================
# ENFORCEMENT MODES — the defaults below are correct for production; these are rollback
# levers (flip to 'shadow'/'off' only during an incident). off | shadow | enforce.
# See docs/TENANT_ENFORCE_FLIP_RUNBOOK.md and docs/SUBSCRIPTION_ENFORCE_FLIP_RUNBOOK.md.
# ===========================================
TENANT_ENFORCEMENT_MODE=enforce
WEBSOCKET_AUTH_MODE=enforce
SUBSCRIPTION_ENFORCEMENT_MODE=off

# ===========================================
# SPRING
# ===========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===========================================
# CORS (your domain)
# ===========================================
CORS_ORIGINS=https://qahvoon.uz,https://www.qahvoon.uz

# ===========================================
# SELF-SERVICE & FILE URLS
# ===========================================
SELFSERVICE_BASE_URL=https://qahvoon.uz/order
FILE_BASE_URL=https://qahvoon.uz/uploads

# ===========================================
# TIMEZONE
# ===========================================
TZ=Asia/Tashkent
TIMEZONE=Asia/Tashkent

# ===========================================
# FILE UPLOADS
# ===========================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ===========================================
# TELEGRAM BOTS (configure from admin panel, or set here)
# ===========================================
# TELEGRAM_BOT_TOKEN=your_customer_bot_token
# TELEGRAM_BOT_USERNAME=your_customer_bot_username
# TELEGRAM_OWNER_BOT_TOKEN=your_owner_bot_token
# TELEGRAM_OWNER_BOT_USERNAME=your_owner_bot_username

# ===========================================
# SMS (optional)
# ===========================================
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=Qahvoon

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
# Required — the stack refuses to start without it. Generate: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ===========================================
# FIRST-BOOT ADMIN (platform operator)
# Created as SUPER_ADMIN only while the users table is empty (deployments start from an empty DB).
# After first login: change the password, then remove ADMIN_PASSWORD.
# ===========================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
