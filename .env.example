# Production Environment Variables for Qahvoon
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#   nano .env

# ===========================================
# BRANDING
# ===========================================
BRAND_NAME=Qahvoon
BRAND_SHORT_NAME=Qahvoon
BRAND_DOMAIN=qahvoon.uz
BRAND_API_URL=https://www.qahvoon.uz
BRAND_SUPPORT_EMAIL=support@qahvoon.uz
BRAND_TEAM_NAME=Qahvoon Team

VITE_BRAND_NAME=Qahvoon
VITE_BRAND_SHORT_NAME=Qahvoon
VITE_BRAND_DOMAIN=qahvoon.uz
VITE_BRAND_API_URL=https://www.qahvoon.uz
VITE_BRAND_SUPPORT_EMAIL=support@qahvoon.uz
# Login-page demo hint. LEAVE BLANK in production — these are baked into the
# frontend bundle and shown on the login screen. Never point them at a real
# account/password.
VITE_BRAND_DEMO_EMAIL=
VITE_BRAND_DEMO_PASSWORD=
VITE_BRAND_COLOR_PRIMARY=#2563eb
VITE_BRAND_COMPANY_NAME=Qahvoon

# ===========================================
# DATABASE
# ===========================================
DB_HOST=db
DB_PORT=5432
DB_NAME=elcafe
DB_USER=elcafe
# Use ONLY letters, digits, and safe symbols (- _ .). Avoid $ ` \ and quotes:
# a $ triggers variable expansion in .env / when the deploy script sources
# this file, silently truncating the password. If the Postgres data dir
# already exists, this must MATCH the password it was initialised with.
DB_PASSWORD=CHANGE_ME_strong_password_no_dollar_sign

# ===========================================
# JWT SECRET
# ===========================================
# Signs all auth tokens. Generate a strong value:  openssl rand -hex 32
# (= 64 hex chars / 512 bits). The app SHA-512-derives the signing key,
# so length is no longer fatal, but entropy still matters — use >= 32
# random bytes. Changing this invalidates all existing tokens (re-login).
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ===========================================
# SPRING
# ===========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===========================================
# CORS (your domain)
# ===========================================
# Comma-separated allowed origins. Entries are trimmed, and each supports
# wildcards (allowedOriginPatterns), so "http://localhost:*" covers any local
# port. Native mobile apps don't send an Origin header and are unaffected by
# this list — it only governs BROWSER requests (the app's web build, Swagger).
#
# The localhost entries below let the waiter app's web build (Expo web on 8081)
# and the admin frontend (Vite on 5173) log in from a browser during
# dev/testing. Remove them for a locked-down production deployment.
CORS_ORIGINS=https://qahvoon.uz,https://www.qahvoon.uz,http://localhost:8081,http://localhost:5173

# ===========================================
# CONSUMER OTP  (PRODUCTION HARDENING — do not omit)
# ===========================================
# The app defaults development-mode to TRUE, which accepts ANY OTP code.
# It MUST be false in production or customer login is wide open.
CONSUMER_OTP_DEVELOPMENT_MODE=false
CONSUMER_OTP_INCLUDE_IN_RESPONSE=false

# ===========================================
# COURIER WEBHOOK
# ===========================================
# Shared secret for courier provider webhooks. Generate: openssl rand -hex 24
COURIER_WEBHOOK_SECRET=CHANGE_ME_run_openssl_rand_hex_24

# ===========================================
# SELF-SERVICE & FILE URLS
# ===========================================
SELFSERVICE_BASE_URL=https://qahvoon.uz/order
FILE_BASE_URL=https://qahvoon.uz/uploads

# ===========================================
# TIMEZONE
# ===========================================
TZ=Asia/Tashkent
TIMEZONE=Asia/Tashkent

# ===========================================
# FILE UPLOADS
# ===========================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ===========================================
# TELEGRAM BOTS
# ===========================================
# Bots default to ENABLED in prod. Set each bot's OWN token (sharing one token
# causes Telegram "409 Conflict"), or configure them in Admin -> Settings ->
# Telegram. To hard-disable a bot regardless of DB config, set its *_ENABLED
# flag to false (that is what docker-compose.local.yml does for local dev).
TELEGRAM_BOT_ENABLED=true
# TELEGRAM_BOT_TOKEN=your_customer_bot_token
# TELEGRAM_BOT_USERNAME=your_customer_bot_username
TELEGRAM_OWNER_BOT_ENABLED=true
# TELEGRAM_OWNER_BOT_TOKEN=your_owner_bot_token
# TELEGRAM_OWNER_BOT_USERNAME=your_owner_bot_username

# ===========================================
# SMS via Eskiz  (required for real OTP delivery)
# ===========================================
# These are the variable names the app actually reads. Without valid Eskiz
# credentials, OTP codes cannot be sent (and CONSUMER_OTP_DEVELOPMENT_MODE
# above must stay false, so logins would fail — configure this for prod).
ESKIZ_SMS_ENABLED=true
ESKIZ_SMS_EMAIL=CHANGE_ME_eskiz_account_email
ESKIZ_SMS_PASSWORD=CHANGE_ME_eskiz_account_password
ESKIZ_SMS_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SMS_CALLBACK_URL=

# ===========================================
# WEB PUSH (VAPID) — optional; push stays off until set
# ===========================================
# Generate a keypair:  npx web-push generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:support@qahvoon.uz

# ===========================================
# WALLET TOP-UPS via Click / Payme — optional (only for online top-ups)
# ===========================================
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=

# ===========================================
# REDIS  (internal only — no auth configured; leave password empty)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
