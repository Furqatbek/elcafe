# Production Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# BRANDING CONFIGURATION (Change to rebrand)
# ===========================================
# Backend branding variables
BRAND_NAME=El Cafe
BRAND_SHORT_NAME=ElCafe
BRAND_TAGLINE=Restaurant Delivery
BRAND_DESCRIPTION=Restaurant Delivery Control Service
BRAND_DOMAIN=elcafe.com
BRAND_API_URL=https://api.elcafe.com
BRAND_SUPPORT_EMAIL=support@elcafe.com
BRAND_TEAM_NAME=ElCafe Team

# Frontend branding variables (VITE_ prefix required)
VITE_BRAND_NAME=El Cafe
VITE_BRAND_SHORT_NAME=ElCafe
VITE_BRAND_TAGLINE=Restaurant Delivery
VITE_BRAND_DESCRIPTION=Restaurant Delivery Control Service
VITE_BRAND_DOMAIN=elcafe.com
VITE_BRAND_API_URL=https://api.elcafe.com
VITE_BRAND_SUPPORT_EMAIL=support@elcafe.com
VITE_BRAND_DEMO_EMAIL=admin@elcafe.com
VITE_BRAND_DEMO_PASSWORD=Admin123!
VITE_BRAND_COLOR_PRIMARY=#2563eb
VITE_BRAND_COMPANY_NAME=ElCafe Inc.

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elcafe_prod
DB_USERNAME=elcafe_user
DB_PASSWORD=your_secure_database_password_here

# ===========================================
# JWT Configuration
# ===========================================
# Generate a secure secret with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_256_bits_here

# ===========================================
# Spring Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# CORS Configuration (optional)
# ===========================================
# Override CORS origins (comma-separated)
# Default: http://localhost:3000,http://localhost:5173,https://lacasa.uz,https://www.lacasa.uz
# CORS_ORIGINS=https://lacasa.uz,https://www.lacasa.uz

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ===========================================
# Email Configuration (if needed)
# ===========================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@lacasa.uz

# ===========================================
# Payment Gateway (if needed)
# ===========================================
# PAYMENT_GATEWAY_API_KEY=your_api_key
# PAYMENT_GATEWAY_SECRET=your_secret_key
# PAYMENT_GATEWAY_MERCHANT_ID=your_merchant_id

# ===========================================
# SMS Provider (if needed)
# ===========================================
# SMS_PROVIDER_API_KEY=your_api_key
# SMS_PROVIDER_SENDER_ID=LACASA

# ===========================================
# Telegram Bot Configuration (Customer Notifications)
# ===========================================
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# ===========================================
# Telegram Owner Bot Configuration (Owner/Staff Notifications)
# ===========================================
# This bot sends notifications to owners about new orders, reservations, etc.
TELEGRAM_OWNER_BOT_ENABLED=true
TELEGRAM_OWNER_BOT_TOKEN=your_owner_bot_token_here
TELEGRAM_OWNER_BOT_USERNAME=your_owner_bot_username

# ===========================================
# Other Configuration
# ===========================================
# LOG_LEVEL=INFO
TZ=Asia/Tashkent
TIMEZONE=Asia/Tashkent
