# Docker Compose Environment Variables

# ===========================================
# BRANDING CONFIGURATION (Change to rebrand)
# ===========================================
# Backend branding variables
BRAND_NAME=El Cafe
BRAND_SHORT_NAME=ElCafe
BRAND_TAGLINE=Restaurant Delivery
BRAND_DESCRIPTION=Restaurant Delivery Control Service
BRAND_DOMAIN=elcafe.com
BRAND_API_URL=https://api.elcafe.com
BRAND_SUPPORT_EMAIL=support@elcafe.com
BRAND_TEAM_NAME=ElCafe Team

# Frontend branding variables (VITE_ prefix required)
VITE_BRAND_NAME=El Cafe
VITE_BRAND_SHORT_NAME=ElCafe
VITE_BRAND_TAGLINE=Restaurant Delivery
VITE_BRAND_DESCRIPTION=Restaurant Delivery Control Service
VITE_BRAND_DOMAIN=elcafe.com
VITE_BRAND_API_URL=https://api.elcafe.com
VITE_BRAND_SUPPORT_EMAIL=support@elcafe.com
VITE_BRAND_DEMO_EMAIL=admin@elcafe.com
VITE_BRAND_DEMO_PASSWORD=Admin123!
VITE_BRAND_COLOR_PRIMARY=#2563eb
VITE_BRAND_COMPANY_NAME=ElCafe Inc.

# ===========================================
# Database Configuration
# ===========================================
DB_NAME=elcafe
DB_USER=elcafe
DB_PASSWORD=elcafe_secure_password_change_me

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_256_bits_here

# ===========================================
# Spring Profile
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# CORS Origins (comma-separated)
# ===========================================
# Default: * (allows all origins)
# For production, specify allowed domains: https://lacasa.uz,https://www.lacasa.uz
CORS_ORIGINS=*

# ===========================================
# Redis Configuration
# ===========================================
# Redis is used for caching and session management
# Default host: redis (Docker service name)
# Default port: 6379
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===========================================
# Frontend API URL
# ===========================================
# Use /api/v1 to match Spring Boot backend endpoints
VITE_API_URL=/api/v1
