# Docker Compose Environment Variables

# ===========================================
# BRANDING CONFIGURATION (Change to rebrand)
# ===========================================
# Backend branding variables
BRAND_NAME=Mega HotDog
BRAND_SHORT_NAME=MegaHotDog
BRAND_TAGLINE=Fast. Fresh. Mega.
BRAND_DESCRIPTION=Mega HotDog ordering & delivery
BRAND_DOMAIN=demo.restos.uz
BRAND_API_URL=https://demo.restos.uz/api/v1
BRAND_SUPPORT_EMAIL=support@restos.uz
BRAND_TEAM_NAME=Mega HotDog Team

# Frontend branding variables (VITE_ prefix required)
VITE_BRAND_NAME=Mega HotDog
VITE_BRAND_SHORT_NAME=MegaHotDog
VITE_BRAND_TAGLINE=Fast. Fresh. Mega.
VITE_BRAND_DESCRIPTION=Mega HotDog ordering & delivery
VITE_BRAND_DOMAIN=demo.restos.uz
VITE_BRAND_API_URL=https://demo.restos.uz/api/v1
VITE_BRAND_SUPPORT_EMAIL=support@restos.uz
VITE_BRAND_DEMO_EMAIL=admin@demo.restos.uz
VITE_BRAND_DEMO_PASSWORD=Admin123!
VITE_BRAND_COLOR_PRIMARY=#E4002B
VITE_BRAND_COMPANY_NAME=Mega HotDog Inc.

# ===========================================
# Database Configuration
# ===========================================
DB_NAME=megahotdog
DB_USER=megahotdog
DB_PASSWORD=CHANGE_ME_strong_db_password

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ===========================================
# Spring Profile
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# CORS Origins (comma-separated)
# ===========================================
# For production, specify allowed domains
CORS_ORIGINS=https://demo.restos.uz

# ===========================================
# Public URLs (used by backend for QR codes & file links)
# ===========================================
SELFSERVICE_BASE_URL=https://demo.restos.uz/order
FILE_BASE_URL=https://demo.restos.uz/uploads

# Website build — demo restaurant id
VITE_RESTAURANT_ID=1

# ===========================================
# Redis Configuration
# ===========================================
# Redis is used for caching and session management
# Default host: redis (Docker service name)
# Default port: 6379
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===========================================
# Frontend API URL
# ===========================================
# Use /api/v1 to match Spring Boot backend endpoints
VITE_API_URL=/api/v1

# ===========================================
# Telegram Bots
# ===========================================
# Telegram bots are now configured via the admin panel
# Go to Settings -> Telegram to configure bot tokens
