# ElCafe Docker Compose Environment Variables

# ===========================================
# Database Configuration
# ===========================================
DB_NAME=elcafe
DB_USER=elcafe
DB_PASSWORD=elcafe_secure_password_change_me

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_256_bits_here

# ===========================================
# Spring Profile
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# CORS Origins (comma-separated)
# ===========================================
# Default: * (allows all origins)
# For production, specify allowed domains: https://lacasa.uz,https://www.lacasa.uz
CORS_ORIGINS=*

# ===========================================
# Redis Configuration
# ===========================================
# Redis is used for caching and session management
# Default host: redis (Docker service name)
# Default port: 6379
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===========================================
# Frontend API URL
# ===========================================
# Use /api for same-origin requests (recommended)
VITE_API_URL=/api
