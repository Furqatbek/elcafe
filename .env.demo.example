# demo.restos.uz — TEMPLATE. Copy to `.env.demo` on the demo host and fill in (it is gitignored;
# never commit real values).
#
#   docker compose --env-file .env.demo up -d --build
#
# Deploy steps: docs/DEMO_DEPLOY.md
#
# This is a SEPARATE deployment from production: its own database, its own containers, its own
# origin. Nothing here can reach real venue data, and a demo session cannot collide with a real one,
# because the browser treats demo.restos.uz and the production host as different origins.

# ============================ REQUIRED ============================

# Generate fresh — do NOT reuse production's. A demo box is shown to people and reached by people
# you do not control; its credentials should be worth nothing anywhere else.
#   openssl rand -base64 24
DB_PASSWORD=
REDIS_PASSWORD=

# openssl rand -hex 32
JWT_SECRET=

# Exactly the demo origin. `*` is rejected at startup under the prod profile.
CORS_ORIGINS=https://demo.restos.uz

# First-boot platform operator, created only while the users table is empty. This is NOT the account
# you demo with — see the venue login below.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================ WHAT MAKES IT A DEMO ============================

# `prod` keeps every production guard on — explicit CORS, API docs off, OTP dev-mode refused at
# boot. `demo` adds the seeder that creates the demo venue, its menu and recipes, a venue admin, and
# a ZBR partner with a 15% channel markup.
#
# Both, in this order, on purpose. A publicly reachable box without the prod guards is a liability,
# and the seeder needs none of them relaxed. The seeder is idempotent: restarts leave the data alone.
SPRING_PROFILES_ACTIVE=prod,demo

# The venue login the seeder creates: demo@restos.uz / DemoPass123!
# Fixed, and fine to be fixed — everything in this deployment is invented. Hand it out privately;
# it is not shown on the login page.
#
# The seeder also prints the ZBR partner API key ONCE, at boot. It is hashed the moment it is
# stored and cannot be shown again:
#   docker compose --env-file .env.demo logs backend | grep "Demo partner key"

# TLS for the demo hostname.
NGINX_CONF=./nginx-proxy/nginx-demo.conf

# Public URLs printed into QR codes and file links.
SELFSERVICE_BASE_URL=https://demo.restos.uz/order
FILE_BASE_URL=https://demo.restos.uz/uploads

# Print direct rather than queueing for a print agent that will never connect. With the default
# (true) every demo order leaves a print_jobs row waiting for an agent — harmless, but it makes the
# print queue look broken to anyone who opens it.
PRINTING_USE_AGENT=false

# ============================ DELIBERATELY LEFT OFF ============================

# CONSUMER_OTP_DEVELOPMENT_MODE — cannot be turned on here. The prod profile refuses to start with
# it set, because dev mode accepts ANY OTP code, which on a public box is consumer account takeover.
# The consequence is honest and worth knowing: the customer-facing ordering app needs a real SMS to
# log a customer in, so it is not demoable on this box without an SMS provider configured below.
# The admin panel and the partner API — the two things worth showing — need none of it.

# ORDER_COMPLETED_EVENTS_ENABLED — left off. On, a completed demo order grants loyalty points and
# sends a completion SMS. Demo orders should not text anybody.

# Payme / Click — left blank, so online payment is disabled. A demo must not be able to take money.

# SMS — left blank. Nothing this box does should reach a real phone. Setting these is the only way
# to demo the customer app, and means demo traffic sends real messages; decide deliberately.
# SPRING_MAIL_HOST / SENTRY_DSN are likewise off: a demo's errors are noise in a production project.

# ============================ OPTIONAL ============================

# DB_NAME=elcafe
# DB_USER=elcafe
