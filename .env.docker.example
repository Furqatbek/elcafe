# Docker Compose environment — TEMPLATE.
#
# Copy to `.env.docker` (which is gitignored) and fill in real values. Do NOT commit `.env.docker`.
# The app fails closed on unset/placeholder secrets, so it will refuse to start until these are real.

# ===========================================
# BRANDING CONFIGURATION (change to rebrand)
# ===========================================
BRAND_NAME=YourBrand
BRAND_SHORT_NAME=YourBrand
BRAND_TAGLINE=Restaurant Delivery
BRAND_DESCRIPTION=Restaurant Delivery Control Service
BRAND_DOMAIN=example.com
BRAND_API_URL=https://www.example.com
BRAND_SUPPORT_EMAIL=support@example.com
BRAND_TEAM_NAME=YourBrand Team

# Frontend branding (VITE_ prefix required)
VITE_BRAND_NAME=YourBrand
VITE_BRAND_SHORT_NAME=YourBrand
VITE_BRAND_TAGLINE=Restaurant Delivery
VITE_BRAND_DESCRIPTION=Restaurant Delivery Control Service
VITE_BRAND_DOMAIN=example.com
VITE_BRAND_API_URL=https://www.example.com
VITE_BRAND_SUPPORT_EMAIL=support@example.com
# Demo login shown on the sign-in screen — use throwaway demo creds only, never a real admin account.
VITE_BRAND_DEMO_EMAIL=demo@example.com
VITE_BRAND_DEMO_PASSWORD=CHANGE_ME
VITE_BRAND_COLOR_PRIMARY=#2563eb
VITE_BRAND_COMPANY_NAME=YourBrand Inc.

# ===========================================
# Database
# ===========================================
DB_NAME=elcafe
DB_USER=elcafe
# Strong, unique password. Generate: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# ===========================================
# JWT (REQUIRED — app refuses to boot without a real value)
# ===========================================
# Generate: openssl rand -hex 32
# Must be >= 32 bytes and NOT any value that was ever committed to the repo (those are blacklisted).
JWT_SECRET=

# ===========================================
# Redis (REQUIRED — compose refuses to start without a password)
# ===========================================
# Generate: openssl rand -base64 24
REDIS_PASSWORD=

# ===========================================
# Spring profile — keep `prod` for production (hardened overrides + fail-fast validator)
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# CORS — explicit origins ONLY (no `*`). A wildcard with credentials is rejected at startup in prod.
# ===========================================
CORS_ORIGINS=https://admin.example.com,https://www.example.com

# ===========================================
# Courier webhook — REQUIRED to accept delivery-status callbacks (fails closed if unset).
# Callers send it as the X-Webhook-Secret header. Generate: openssl rand -hex 24
# ===========================================
COURIER_WEBHOOK_SECRET=

# ===========================================
# Consumer OTP — MUST stay false in production (dev mode accepts ANY OTP code).
# The prod profile forces this false and the app refuses to boot if it is true under `prod`.
# ===========================================
CONSUMER_OTP_DEVELOPMENT_MODE=false

# ===========================================
# Password-reset email (optional). Without SMTP configured, the forgot-password flow logs a warning
# and sends nothing (it does not pretend to have delivered). Set these to enable it.
# ===========================================
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# MAIL_RESET_PASSWORD_URL=https://admin.example.com/reset-password

# ===========================================
# Frontend API URL
# ===========================================
VITE_API_URL=/api/v1

# ===========================================
# Telegram bots — configured via the admin panel (Settings -> Telegram)
# ===========================================
