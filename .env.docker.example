# elcafe environment — TEMPLATE. Copy to `.env.docker` and fill in (it is gitignored;
# never commit real values). Compose refuses to start while required values are missing,
# and the app fails closed on placeholder secrets.
#
# Launch steps: docs/LAUNCH.md

# ============================ REQUIRED ============================

# Database password. Generate: openssl rand -base64 24
DB_PASSWORD=

# Redis password. Generate: openssl rand -base64 24
REDIS_PASSWORD=

# JWT signing secret, >= 32 bytes. Generate: openssl rand -hex 32
# Never reuse a value that was ever committed to the repo (those are blacklisted at boot).
JWT_SECRET=

# Exact allowed browser origins, comma-separated — no `*` (rejected at startup in prod).
CORS_ORIGINS=https://admin.example.com,https://www.example.com

# First-boot platform operator. Created as SUPER_ADMIN only while the users table is empty
# (deployments always start from an empty database — migrations seed no users). After first
# login: change the password, then remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================ OPTIONAL ============================

# nginx config: the default (nginx-local.conf) is HTTP-only. For TLS on a real domain:
# NGINX_CONF=./nginx-proxy/nginx.conf

# Public base URLs printed into QR codes / file links (defaults: qahvoon.uz).
# SELFSERVICE_BASE_URL=https://your-domain/order
# FILE_BASE_URL=https://your-domain/uploads

# Courier delivery-status callbacks (X-Webhook-Secret header). The webhook endpoint rejects
# everything while this is unset. Generate: openssl rand -hex 24
# COURIER_WEBHOOK_SECRET=

# Password-reset email. Without SMTP the forgot-password flow logs a warning and sends nothing.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# MAIL_RESET_PASSWORD_URL=https://admin.example.com/reset-password

# Observability (both dormant by default).
# LOG_FORMAT=json            # one JSON object per line on the console, for log aggregation
# SENTRY_DSN=                # backend error tracking; unset = completely off
# SENTRY_ENVIRONMENT=production
# VITE_SENTRY_DSN=           # frontend error tracking (separate DSN); unset = SDK never loaded

# Loyalty/marketing activation (product decision; default off). true = settled+paid orders
# grant loyalty points, milestone visits, first-order bonus and completion SMS.
# ORDER_COMPLETED_EVENTS_ENABLED=true

# Telegram Mini App (in-Telegram customer ordering). Set the base URL to show the bot's order
# button; it must be public HTTPS and point at the customer app's /order/tg entry. Each restaurant
# still needs its bot token configured in the app (Telegram settings), not here.
# APP_TELEGRAM_MINIAPP_BASE_URL=https://your-domain/order/tg
# APP_TELEGRAM_MINIAPP_AUTO_ACCEPT=true          # false = staff must accept Telegram orders first

# Payme / Click — fund the loyalty wallet that pays online orders. Leave a provider blank to disable
# it. The *_KEY / *_SECRET_KEY values also authenticate the inbound top-up webhooks (fail closed).
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=

# Rollback levers — defaults are correct for production; flip only during an incident.
# TENANT_ENFORCEMENT_MODE=enforce        # -> shadow to relax tenant isolation
# WEBSOCKET_AUTH_MODE=enforce            # -> shadow to relax WebSocket auth
# SUBSCRIPTION_ENFORCEMENT_MODE=off      # subscription gate: off | shadow | enforce
# CONSUMER_OTP_DEVELOPMENT_MODE=false    # MUST stay false in production

# Database name/user (rarely changed; both default to elcafe).
# DB_NAME=elcafe
# DB_USER=elcafe
