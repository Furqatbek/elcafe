              "raw": "{\n  \"restaurantId\": 1,\n  \"tableNumber\": \"T-101\",\n  \"tableName\": \"Window Table\",\n  \"capacity\": 4,\n  \"section\": \"Main Hall\",\n  \"notes\": \"Near window\",\n  \"active\": true\n}"
