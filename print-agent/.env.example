# Qahvoon Print Agent Configuration

# Backend server WebSocket URL (path is /ws-print-agent, no /api prefix)
SERVER_URL=wss://www.qahvoon.uz/ws-print-agent

# Your restaurant ID from the admin panel
RESTAURANT_ID=1

# Authentication token (REQUIRED once the server enforces WebSocket auth).
# Mint it in the admin panel: POST /api/v1/settings/print-agent/token (as an ADMIN of this restaurant),
# then paste the returned token here. Scoped to this restaurant only; valid ~1 year.
# (Minting a new one does not revoke a prior token — keep it secret.)
AGENT_TOKEN=

# Agent ID (optional - auto-generated if not set)
# AGENT_ID=kitchen-printer-1

# Reconnection delay in milliseconds (default: 5000)
RECONNECT_DELAY=5000

# ============================================
# Printer Configuration
# ============================================

# Printer type: 'usb' or 'network'
PRINTER_TYPE=network

# For USB printers:
# Leave blank to auto-detect, or specify printer name
# PRINTER_NAME=

# For network printers:
# Your thermal printer's IP address
PRINTER_IP=192.168.1.100

# Printer port (default: 9100 for most thermal printers)
PRINTER_PORT=9100
