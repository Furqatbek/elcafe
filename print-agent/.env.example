# ElCafe Print Agent Configuration

# Backend server WebSocket URL
SERVER_URL=wss://api.elcafe.uz/ws-print-agent

# Your restaurant ID from the admin panel
RESTAURANT_ID=1

# Agent ID (optional - auto-generated if not set)
# AGENT_ID=kitchen-printer-1

# Reconnection delay in milliseconds (default: 5000)
RECONNECT_DELAY=5000

# ============================================
# Printer Configuration
# ============================================

# Printer type: 'usb' or 'network'
PRINTER_TYPE=network

# For USB printers:
# Leave blank to auto-detect, or specify printer name
# PRINTER_NAME=

# For network printers:
# Your thermal printer's IP address
PRINTER_IP=192.168.1.100

# Printer port (default: 9100 for most thermal printers)
PRINTER_PORT=9100
